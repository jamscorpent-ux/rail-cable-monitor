# tests/test_cable_logic.py
from src.rail_cable_monitor import CableGuardPoC

def test_initial_status():
    # Ujian: Pastikan sistem bermula dalam keadaan 'CONNECTED'
    monitor = CableGuardPoC("TEST-01")
    assert monitor.status == "CONNECTED"

def test_tamper_detection():
    # Ujian: Simulasi kabel dipotong dan check jika sistem detect
    monitor = CableGuardPoC("TEST-02")
    # Kita tukar status secara manual untuk test logic alert
    monitor.status = "DISCONNECTED"
    assert monitor.status == "DISCONNECTED"
