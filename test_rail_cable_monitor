# tests/test_monitor.py
import sys
import os

# Memastikan pytest boleh jumpa folder src
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '../src')))

from rail_cable_monitor import CableGuardPoC

def test_initial_state():
    # Ujian: Pastikan sensor bermula dengan status CONNECTED
    monitor = CableGuardPoC("TEST-ZONE")
    assert monitor.status == "CONNECTED"

def test_alert_logic():
    # Ujian: Pastikan alert berfungsi bila status berubah
    monitor = CableGuardPoC("TEST-ZONE")
    monitor.status = "DISCONNECTED"
    assert monitor.status == "DISCONNECTED"
